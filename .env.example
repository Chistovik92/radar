# --- обязательные параметры ---
# Токен Telegram-бота, получить у @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Ваш Telegram ID, узнать у @userinfobot
SUPERADMIN_ID=0

# --- ИИ (без ключа бот работает на эвристическом анализе) ---
# Ключ Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель для диалога. Если она окажется недоступна ключу, бот сам подберёт
# рабочую из списка кандидатов — проверить можно командой /models
GEMINI_MODEL=gemini-3.6-flash
# Модель для разбора новостей: дешевле и с большей квотой
GEMINI_MODEL_ANALYSIS=gemini-3.5-flash-lite
AI_CONCURRENCY=2
AI_TIMEOUT=90

# --- квоты Gemini (свои значения смотрите в AI Studio) ---
# Запросов в минуту и в сутки
AI_RPM=10
AI_RPD=250
# Сколько суточных запросов держать в резерве только под ассистента
AI_RESERVE=40
# Сколько новостей разбирать одним запросом
AI_BATCH_SIZE=8
# Пауза фонового анализа после ответа 429, секунды
AI_COOLDOWN=900
# Отсев заведомо нерелевантных сообщений до обращения к модели (1/0)
AI_PREFILTER=1
# Поиск в интернете для ассистента (1/0)
AI_SEARCH=1

# --- база данных ---
# sqlite — по умолчанию: файл рядом с ботом, ничего настраивать не нужно,
# отдельный контейнер не поднимается. Проверенный вариант для одноплатника.
# postgres — для машины помощнее; тогда запускайте с профилем:
#   docker compose --profile postgres up -d
DB_BACKEND=sqlite
DB_FILE=data/radar.db

# Ниже — только для DB_BACKEND=postgres.
# Пароль без символа $: Compose трактует его как подстановку переменной.
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=radar
DB_USER=radar
# DATABASE_URL=postgresql://user:pass@host:5432/radar
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Сколько дней хранить историю событий; 0 — бессрочно
EVENT_RETENTION_DAYS=180

# --- выход в интернет через внешний узел ---
# Задаётся из бота: «Управление» → «Выход в сеть». Вручную менять не нужно.
# Ключ сам по себе ничего не включает: сервер выбирается отдельно.
EGRESS_PROXY=
EGRESS_SOURCE=
EGRESS_SELECTED=

# Провайдер разбора новостей: gemini | deepseek
AI_PROVIDER=gemini
# Ключ шифрования подписок и ключей в базе (сгенерируйте случайный)
SECRET_KEY=

# --- источники VK и OK (версия 4.1) ---
# Сервисный ключ приложения ВКонтакте
VK_SERVICE_TOKEN=
# Одноклассники: приложение регистрируется на apiok.ru
OK_APPLICATION_KEY=
OK_ACCESS_TOKEN=
OK_SECRET_KEY=

# --- загрузка видео по ссылке (версия 4.2) ---
# Включается флагом media_download в /features
MEDIA_ENABLED=0
# Кому доступна: user | moderator | admin | superadmin
MEDIA_MIN_ROLE=moderator
MEDIA_DIR=data/media
# Одновременных загрузок; на одноплатнике оставьте 1
MEDIA_CONCURRENCY=1
# Ограничение скорости, например 2M — чтобы бот не забивал канал
MEDIA_RATE_LIMIT=
# Файл cookies для закрытых площадок
MEDIA_COOKIES=

# Собственный Bot API Server поднимает предел отправки с 50 МБ до 2 ГБ.
# Ключи берутся на my.telegram.org → API development tools.
# Запуск: docker compose --profile media up -d
TELEGRAM_API_SERVER=
TELEGRAM_API_LOCAL=1
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- веб-панель (версия 4.5) ---
# Включается флагом web_panel. Отдельный процесс: её сбой не влияет на бота.
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Обязательно 1, если панель доступна снаружи: иначе cookie сессии
# передаётся открытым текстом
WEB_HTTPS=0

# --- новостные подборки (версия 4.4) ---
# Тарифы в формате «дни:звёзды» через запятую; задаются командой /digestprice
DIGEST_PLANS=30:150, 90:400, 365:1400

# --- мессенджер MAX (версия 4.2) ---
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
MAX_MODE=polling
MAX_WEBHOOK_URL=
MAX_WEBHOOK_PORT=8081

# --- поведение ---
TZ=Europe/Saratov
# Город по умолчанию, если он не определился из геопозиции
DEFAULT_CITY=Саратов
# Наборы источников, подключаемые при первом запуске (см. radar/presets.py):
# saratov, moscow, spb, kazan, samara — через запятую
SOURCE_CITIES=saratov
# Секунд между обходами источников
POLL_INTERVAL=180
# Сколько последних сообщений читать в каждом источнике
MSG_PER_SOURCE=5
# Радиус объединения локаций в одну сводку, метры
CLUSTER_RADIUS_M=1000
# Лимит локаций на пользователя, 0 — без ограничения
MAX_LOCATIONS=0
# Дополнительные каналы и RSS-ленты через запятую
EXTRA_CHANNELS=
EXTRA_RSS=
LOG_LEVEL=INFO
# Каталог журналов внутри data/ — только оттуда бот может их отдать
LOG_DIR=data/logs
# Сколько дней хранить журналы; 0 — бессрочно
LOG_KEEP_DAYS=14
# Максимальный размер файла журнала бота, МБ
LOG_MAX_MB=5
# Ограничение памяти контейнера бота (для 1–2 ГБ ставьте 384M–512M)
RADAR_MEM_LIMIT=512M

# --- партнёрский блок (кнопка в главном меню) ---
PROMO_ENABLED=1
PROMO_TITLE=🐙 HydraSite
PROMO_URL=https://t.me/+WWJFBZVhxBs4ZmNi
# Показывать промо внутри оповещений об угрозах (не рекомендуется)
PROMO_IN_ALERTS=0
