# Ключи провайдеров. Заполняйте только те, что есть — остальные пропускаются.
# Скопируйте этот файл в .env

# --- США / Европа ---
GEMINI_API_KEY=          # https://aistudio.google.com/api-keys
GROQ_API_KEY=            # https://console.groq.com/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
MISTRAL_API_KEY=         # https://console.mistral.ai  (Франция, ЕС)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
GITHUB_TOKEN=            # обычный PAT, https://github.com/settings/tokens
NVIDIA_API_KEY=          # https://build.nvidia.com
TOGETHER_API_KEY=        # https://api.together.ai
SAMBANOVA_API_KEY=       # https://cloud.sambanova.ai
COHERE_API_KEY=          # https://dashboard.cohere.com
OPENAI_API_KEY=          # платный
ANTHROPIC_API_KEY=       # платный

# --- Азия ---
DEEPSEEK_API_KEY=        # https://platform.deepseek.com
ZAI_API_KEY=             # https://z.ai  (GLM / Zhipu)
MOONSHOT_API_KEY=        # https://platform.moonshot.ai  (Kimi)
DASHSCOPE_API_KEY=       # https://modelstudio.console.alibabacloud.com  (Qwen)
MINIMAX_API_KEY=         # https://www.minimax.io
